# Cấu hình MySQL 8.4 tối giản cho sandbox một phiên. measure.sh đổi từng dòng thành tham số mysqld (bind mount từ Windows bị bỏ qua vì quyền 0777); trên Linux có thể mount :ro vào /etc/mysql/conf.d/.
[mysqld]
# Task016 cần performance_schema.data_lock_waits để bắt chờ khóa
performance_schema=ON
# Các bảng instrument tự chia theo bộ nhớ máy; ép nhỏ để bớt vài chục MB
performance_schema_digests_size=200
performance_schema_events_statements_history_long_size=100
performance_schema_events_waits_history_long_size=100
performance_schema_events_transactions_history_long_size=100
performance_schema_events_stages_history_long_size=100
performance_schema_max_table_instances=200
performance_schema_max_file_instances=500
# Dữ liệu mẫu chỉ vài chục nghìn dòng; mặc định 128M là thừa
innodb_buffer_pool_size=32M
innodb_buffer_pool_instances=1
# Mức nhỏ nhất InnoDB cho phép
innodb_log_buffer_size=1M
# Redo log nhỏ cho đĩa và thời gian khởi tạo; tối thiểu 8M
innodb_redo_log_capacity=16M
innodb_sort_buffer_size=64K
# Mỗi phiên chỉ có 2 đến 3 connection thử khóa
max_connections=20
# Bộ đệm theo từng connection, giữ nhỏ để 20 connection không nở RAM
sort_buffer_size=256K
join_buffer_size=256K
read_buffer_size=128K
read_rnd_buffer_size=256K
tmp_table_size=4M
max_heap_table_size=4M
key_buffer_size=1M
# Ít bảng nên cache nhỏ (table_definition_cache tối thiểu 400)
table_open_cache=64
table_definition_cache=400
# Ít thread nền hơn: bớt RAM stack và bớt số pid
innodb_read_io_threads=1
innodb_write_io_threads=1
innodb_page_cleaners=1
innodb_purge_threads=1
# Sandbox dùng một lần, không cần binlog
skip-log-bin
# Không cần X Protocol (cổng 33060)
mysqlx=OFF
# Không tra DNS, tránh host cache
skip-name-resolve
# Chặn LOAD DATA LOCAL: SQL người dùng không đáng tin
local_infile=OFF
# Chặn SELECT INTO OUTFILE và LOAD_FILE ra ngoài thư mục dữ liệu
secure_file_priv=NULL
# Task037: một dòng kết quả tối đa 4M. Mặc định 64M làm agent phình RAM gấp 22 lần (60 MB dòng thành 279 MB RSS) và biến SQL người dùng thành đòn đánh vào RAM máy chủ. Biến này chỉ đọc ở mức session nên người dùng không nâng lại được.
max_allowed_packet=4M
# Task037: bảng tạm nội bộ (GROUP BY, ORDER BY, CTE) không chiếm RAM mặc định 1 GiB; tràn thì ghi InnoDB trong thư mục dữ liệu, đã có hạn mức đĩa
temptable_max_ram=2M
temptable_max_mmap=0
